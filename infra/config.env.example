# Copy this file to infra/config.env (git-ignored) and fill in your values.
# Never commit config.env. No account ID, keys or real bucket names in Git.

AWS_REGION=eu-central-1
PROJECT=rag-bot-observability

# Globally unique bucket name, without account ID
BUCKET=rag-bot-obs-CHANGE-ME-euc1

GLUE_DATABASE=rag_bot_obs
# Glue 6.0 is about 30 % cheaper; use 5.0 if 6.0 is not accepted
GLUE_VERSION=6.0

# Budget alert (NFR-03)
ALERT_EMAIL=you@example.com
BUDGET_USD=50
